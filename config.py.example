# ========== ХЕЛПЕР ==========

def get_messages_for(chat_id: str, base_name: str) -> list:
    gender = ALLOWED_CHATS.get(chat_id, {}).get("gender", "m")
    suffix = "_F" if gender == "f" else "_M"
    return globals()[f"{base_name}{suffix}"]