BASE = f"https://3100.api.green-api.com/waInstance{ID_INSTANCE}"

# ===== ЧАТЫ =====
# chatId → параметры чата.
# gender: "m" (мужской), "f" (женский).
# Время в 24-часовом формате, только *:00 (таймер запускается раз в час).
