[Unit]
Description=MAX Bot - Listener + Hermes Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=a1
Group=a1
WorkingDirectory=/home/a1/max-bot
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/home/a1/max-bot/venv/bin/python /home/a1/max-bot/bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
