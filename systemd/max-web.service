[Unit]
Description=MAX Bot Web UI
After=network.target

[Service]
Type=simple
User=a1
Group=a1
WorkingDirectory=/home/a1/max-bot
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/home/a1/max-bot/venv/bin/python -m uvicorn web.app:app --host 127.0.0.1 --port 9118
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
